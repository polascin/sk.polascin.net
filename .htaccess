# Bezpečnostné nastavenia
Options -Indexes
ServerSignature Off

# Globálne bezpečnostné HTTP hlavičky
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # Content-Security-Policy
    # - script-src 'self': žiadne inline skripty (JS je v /js/current.js)
    # - style-src 'unsafe-inline': web má množstvo inline style="" atribútov a <style> blok
    # - img-src: vlastná doména + externé obrázky (logá z polascin.net, affiliate bannery)
    # - frame-src 'self': vložený PDF dokument docs/mel.pdf z vlastnej domény
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://polascin.net https://d2emjept89nv7b.cloudfront.net https://www.martinus.sk; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Blokovanie .git a citlivých súborov
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|pem|key|p12|pfx|log|sql|bak)$">
    Require all denied
</FilesMatch>

# Lokálne dev konfigy (PHPStan, PHP-CS-Fixer) — len lokálny vývoj, nie cez web
<FilesMatch "^(phpstan.*|\.php-cs-fixer.*)$">
    Require all denied
</FilesMatch>

# Konfigurácia databázy — nikdy nesmie byť dostupná cez web
<FilesMatch "^db\.config.*\.php$">
    Require all denied
</FilesMatch>

# Interné Markdown dokumenty (.agent.md, AGENTS.md, README, …) — nie cez web
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# Blokovanie interných adresárov
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.git|\.claude|\.vscode|blocks|files)(/.*)?$ - [F,L]
    # docs/: adresár nie je verejne prehľadávateľný, ale docs/mel.pdf je zámerne
    # vložený na stránke (odkaz aj iframe), preto ho ako jediný ponechávame dostupný.
    RewriteRule ^docs/(?!mel\.pdf$).* - [F,L]
</IfModule>
