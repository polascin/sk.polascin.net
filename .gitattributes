# Normalizácia koncov riadkov: LF v gite aj v pracovnom strome.
# Znižuje šum PHP-CS-Fixer (CRLF↔LF) na Windows.
* text=auto eol=lf

*.php  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.htm  text eol=lf
*.xml  text eol=lf
*.neon text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.svg  text eol=lf
*.htaccess text eol=lf

# Windows shell skripty: CRLF (Grok Beh #10)
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.phar binary
